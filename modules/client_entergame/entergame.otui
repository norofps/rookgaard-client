// ============================================================
// Rookgaard Login Screen
// Flat layout over wallpaper — no window, no drag
// ============================================================

// Custom styles (scoped to this file)
RookLabel < Label
  font: Verdana Bold-13px
  color: #ffffffdd
  text-auto-resize: true
  background-color: alpha

RookInput < TextQtEdit
  height: 32
  color: #e0e0e0ff
  font: verdana-11px-antialised
  background-color: #111111cc
  padding-left: 10
  padding-right: 32

RookButton < UIButton
  height: 34
  font: Verdana Bold-13px
  color: #ffffffee
  background-color: #111111bb
  border-width: 1
  border-color: #888888aa
  text-align: center
  change-cursor-image: true
  cursor: pointer

  $hover:
    background-color: #222222cc
    border-color: #aaaaaacc

  $pressed:
    background-color: #333333cc

// ============================================================
// Main container — centered, fully transparent
// ============================================================
UIWidget
  id: enterGame
  size: 300 295
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.verticalCenter: parent.verticalCenter
  background-color: alpha
  focusable: true
  @onEnter: EnterGame.doLogin()

  // --- E-MAIL ---
  RookLabel
    id: emailLabel
    text: E-MAIL
    anchors.left: parent.left
    anchors.top: parent.top

  RookInput
    id: accountNameTextEdit
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: emailLabel.bottom
    margin-top: 4

  // --- PASSWORD ---
  RookLabel
    id: passwordLabel
    text: PASSWORD
    anchors.left: parent.left
    anchors.top: accountNameTextEdit.bottom
    margin-top: 16

  // Password input with eye-toggle (text hidden by default)
  RookInput
    id: accountPasswordTextEdit
    text-hidden: true
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: passwordLabel.bottom
    margin-top: 4

    UICheckBox
      size: 19 20
      anchors.right: parent.right
      margin-right: 6
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/ui/hide_eye
      phantom: false
      @onCheckChange: |
        self:getParent():setTextHidden(not self:isChecked())
      $!checked:
        image-clip: 0 0 19 20
      $checked:
        image-clip: 0 20 19 20

  // --- REMEMBER ME ---
  QtCheckBox
    id: rememberEmailBox
    !text: tr('Remember Me')
    color: #c0c0c0dd
    font: verdana-11px-antialised
    anchors.left: parent.left
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 14
    @onCheckChange: |
      self:getParent():getChildById('autoLoginBox'):setEnabled(self:isChecked())
      self:getParent():getChildById('rememberEmailTip'):setOn(self:isChecked())

  UIWidget
    id: rememberEmailTip
    visible: false
    $on:
      visible: true
    $!on:
      visible: false

  // --- LOGIN BUTTON ---
  RookButton
    !text: tr('Login')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: rememberEmailBox.bottom
    width: 200
    margin-top: 14
    @onClick: EnterGame.doLogin()

  // --- FORGOT PASSWORD ---
  UIButton
    id: Forgot_password_email
    !text: tr('Forgot password')
    font: verdana-11px-monochrome-underline
    color: #a0a0a0cc
    text-align: center
    background-color: alpha
    text-auto-resize: true
    visible: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 10
    change-cursor-image: true
    cursor: pointer
    @onClick: g_platform.openUrl(Services.websites)
    @onSetup: |
      if Services and Services.websites then
        self:setVisible(true)
      else
        self:setVisible(false)
      end

  // --- CREATE ACCOUNT ---
  UIButton
    id: btnCreateNewAccount
    !text: tr('Create Account')
    font: verdana-11px-monochrome-underline
    color: #a0a0a0cc
    text-align: center
    background-color: alpha
    text-auto-resize: true
    visible: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 6
    change-cursor-image: true
    cursor: pointer
    @onClick: |
      self:disable()
      createWidgetAccount()
    @onSetup: |
      if Services and Servers_init and table.size(Servers_init) == 1 and Services.createAccount then
        self:setVisible(true)
      else
        self:setVisible(false)
      end

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 4
    color: #00dd00
    text-auto-resize: true

  // ============================================================
  // Hidden fields — required by entergame.lua, never visible
  // ============================================================
  QtCheckBox
    id: stayLoggedBox
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top
    $on:
      visible: false
      height: 0

  TextEdit
    id: serverHostTextEdit
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  TextEdit
    id: serverPortTextEdit
    text: 7171
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  ComboBox
    id: clientComboBox
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top
    menu-scroll: true
    menu-height: 125
    menu-scroll-step: 25

  Label
    id: serverLabel
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  Label
    id: portLabel
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  Label
    id: clientLabel
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  UIWidget
    id: serverListButton
    visible: false
    height: 0
    width: 0
    anchors.left: parent.left
    anchors.top: parent.top

  QtCheckBox
    id: autoLoginBox
    enabled: false
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  QtCheckBox
    id: httpLoginBox
    enabled: true
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top
