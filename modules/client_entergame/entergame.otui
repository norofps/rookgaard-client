// ============================================================
// Rookgaard Login Screen — clean flat layout over wallpaper
// ============================================================

// Smooth TTF label with dark outline for contrast on any background
RookLabel < Label
  ttf-font: verdana-bold
  ttf-font-size: 13
  ttf-stroke-width: 1
  ttf-stroke-color: #000000ff
  color: #ffffffff
  text-auto-resize: true
  background-color: alpha

// Clean input field: dark translucent, subtle border, smooth text
RookInput < UITextEdit
  height: 34
  color: #ffffffff
  ttf-font: verdana-bold
  ttf-font-size: 11
  text-align: left
  background-color: #0a0a0abb
  border-width: 1
  border-color: #ffffff33
  padding-left: 14
  padding-right: 38
  padding-top: 10
  padding-bottom: 10
  cursor: none
  selection-color: #ffffff
  selection-background-color: #555555

// Transparent eye toggle (no button background)
RookEye < UICheckBox
  size: 19 20
  image-source: /images/ui/rook_eye
  image-color: #b0b0b0ff
  background-color: alpha
  change-cursor-image: true
  cursor: pointer
  $hover:
    image-color: #ffffffff

// Bordered login button with a subtle golden frame
RookButton < UIButton
  height: 38
  ttf-font: verdana-bold
  ttf-font-size: 14
  ttf-stroke-width: 1
  ttf-stroke-color: #000000aa
  color: #ffffffff
  background-color: #000000bb
  border-width: 1
  border-color: #c2a35ccc
  text-align: center
  change-cursor-image: true
  cursor: pointer
  $hover:
    background-color: #1a1a1add
    border-color: #e6c87aff
  $pressed:
    background-color: #2a2a2add

// Smooth small underlined link
RookLink < UIButton
  ttf-font: verdana-bold
  ttf-font-size: 10
  color: #b8b8b8ff
  text-align: center
  background-color: alpha
  text-auto-resize: true
  change-cursor-image: true
  cursor: pointer
  $hover:
    color: #ffffffff

// ============================================================
// Main container — centered, fully transparent
// ============================================================
UIWidget
  id: enterGame
  size: 320 300
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.verticalCenter: parent.verticalCenter
  background-color: alpha
  focusable: true
  @onEnter: EnterGame.doLogin()

  // --- E-MAIL ---
  RookLabel
    id: emailLabel
    text: E-MAIL
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top

  RookInput
    id: accountNameTextEdit
    padding-left: 42
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: emailLabel.bottom
    margin-top: 6

    // dropdown arrow (saved accounts) — far left, before text starts
    UIButton
      id: savedAccountsButton
      size: 10 10
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      image-source: /images/ui/icon-arrow7x7-down
      image-color: #b0b0b0ff
      background-color: alpha
      change-cursor-image: true
      cursor: pointer
      $hover:
        image-color: #ffffffff
      @onClick: EnterGame.showSavedAccounts()

    // thin separator between arrow and text
    UIWidget
      width: 1
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 32
      margin-top: 7
      margin-bottom: 7
      background-color: #ffffff22
      phantom: true

    // eye toggle (hide/show email) — flush right, ends the field
    RookEye
      anchors.right: parent.right
      margin-right: 8
      anchors.verticalCenter: parent.verticalCenter
      @onCheckChange: self:getParent():setTextHidden(self:isChecked())
      $!checked:
        image-clip: 0 0 19 20
      $checked:
        image-clip: 0 20 19 20

  // --- PASSWORD ---
  RookLabel
    id: passwordLabel
    text: PASSWORD
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: accountNameTextEdit.bottom
    margin-top: 18

  RookInput
    id: accountPasswordTextEdit
    text-hidden: true
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: passwordLabel.bottom
    margin-top: 6

    // eye toggle (hide/show password) — flush right, ends the field
    RookEye
      anchors.right: parent.right
      margin-right: 8
      anchors.verticalCenter: parent.verticalCenter
      @onCheckChange: self:getParent():setTextHidden(not self:isChecked())
      $!checked:
        image-clip: 0 0 19 20
      $checked:
        image-clip: 0 20 19 20

  // --- REMEMBER ME ---
  QtCheckBox
    id: rememberEmailBox
    !text: tr('REMEMBER ME')
    ttf-font: verdana-bold
    ttf-font-size: 11
    ttf-stroke-width: 1
    ttf-stroke-color: #000000ff
    color: #ffffffff
    text-offset: 20 0
    text-auto-resize: true
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: accountPasswordTextEdit.bottom
    margin-top: 20
    @onCheckChange: |
      self:getParent():getChildById('autoLoginBox'):setEnabled(self:isChecked())
      self:getParent():getChildById('rememberEmailTip'):setOn(self:isChecked())

  UIWidget
    id: rememberEmailTip
    visible: false
    $on:
      visible: true
    $!on:
      visible: false

  // --- LOGIN BUTTON ---
  RookButton
    !text: tr('Login')
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: rememberEmailBox.bottom
    width: 220
    margin-top: 16
    @onClick: EnterGame.doLogin()

  // --- FORGOT PASSWORD ---
  RookLink
    id: Forgot_password_email
    !text: tr('Forgot password')
    visible: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 12
    @onClick: g_platform.openUrl(Services.websites)
    @onSetup: |
      if Services and Services.websites then
        self:setVisible(true)
      else
        self:setVisible(false)
      end

  // --- CREATE ACCOUNT ---
  RookLink
    id: btnCreateNewAccount
    !text: tr('Create Account')
    visible: false
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 7
    @onClick: |
      self:disable()
      createWidgetAccount()
    @onSetup: |
      if Services and Servers_init and table.size(Servers_init) == 1 and Services.createAccount then
        self:setVisible(true)
      else
        self:setVisible(false)
      end

  Label
    id: serverInfoLabel
    font: verdana-11px-rounded
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: prev.bottom
    margin-top: 6
    color: #00dd00
    text-auto-resize: true

  // ============================================================
  // Hidden fields — required by entergame.lua, never visible
  // ============================================================
  QtCheckBox
    id: stayLoggedBox
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top
    $on:
      visible: false
      height: 0

  TextEdit
    id: serverHostTextEdit
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  TextEdit
    id: serverPortTextEdit
    text: 7171
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  ComboBox
    id: clientComboBox
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top
    menu-scroll: true
    menu-height: 125
    menu-scroll-step: 25

  Label
    id: serverLabel
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  Label
    id: portLabel
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  Label
    id: clientLabel
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  UIWidget
    id: serverListButton
    visible: false
    height: 0
    width: 0
    anchors.left: parent.left
    anchors.top: parent.top

  QtCheckBox
    id: autoLoginBox
    enabled: false
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top

  QtCheckBox
    id: httpLoginBox
    enabled: true
    visible: false
    height: 0
    anchors.left: parent.left
    anchors.top: parent.top
